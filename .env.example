ENVIRONMENT=development
SEED_DEMO_ON_STARTUP=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./app/data/forgemind.db
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=forgemind
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=http://localhost:8001
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER=local
RETRIEVAL_BACKEND=local
DOCUMENT_STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=25000000

# Set AI_PROVIDER=azure and RETRIEVAL_BACKEND=azure_search for the Azure vertical slice.
# API keys are convenient locally. In Azure Container Apps, leave them empty and use managed identity.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=forgemind-chunks
AZURE_SEARCH_VECTOR_DIMENSIONS=1536

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=forgemind-documents

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
